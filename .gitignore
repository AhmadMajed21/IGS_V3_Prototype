# This .gitignore file should be placed at the root directory ABOVE your Unity project
# Example:
# RootDirectory/
# └── IGS Prototypes/
#
# All Unity paths below are scoped to the project folder.

IGS Prototypes/[Ll]ibrary/
IGS Prototypes/[Tt]emp/
IGS Prototypes/[Oo]bj/
IGS Prototypes/[Bb]uild/
IGS Prototypes/[Bb]uilds/
IGS Prototypes/[Ll]ogs/
IGS Prototypes/[Uu]ser[Ss]ettings/
*.log

# Unity temp file
.utmp/

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
IGS Prototypes/[Mm]emoryCaptures/

# Recordings can get excessive in size
IGS Prototypes/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# IGS Prototypes/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
IGS Prototypes/[Aa]ssets/Plugins/Editor/JetBrains*

# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
IGS Prototypes/ServerData
IGS Prototypes/[Aa]ssets/StreamingAssets/aa*
IGS Prototypes/[Aa]ssets/AddressableAssetsData/link.xml*
IGS Prototypes/[Aa]ssets/Addressables_Temp*

# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders
IGS Prototypes/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
IGS Prototypes/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
IGS Prototypes/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
IGS Prototypes/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
IGS Prototypes/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
IGS Prototypes/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
IGS Prototypes/[Aa]ssets/[Ss]ceneDependencyCache*